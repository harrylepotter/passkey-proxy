{
  "manifest_version": 3,
  "name": "Passkey Proxy \u2014 local proof of concept",
  "version": "0.4.1",
  "description": "Manage vault passkeys and share a website's current session with a one-time invite.",
  "permissions": [
    "storage",
    "webAuthenticationProxy",
    "activeTab"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Passkey Proxy"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
